{
  "routes": [
    {
      "route": "/firebase_edit_alarm.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/relays.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/firebase_relay_logs.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/alarm",
      "methods": ["GET", "PUT"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/relays",
      "methods": ["GET"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/relay-logs",
      "methods": ["GET", "DELETE"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/command",
      "methods": ["PUT"],
      "allowedRoles": ["kurudere_admin"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  }
}