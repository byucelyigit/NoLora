{
  "routes": [
    {
      "route": "/firmware/version.json",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "route": "/firmware/*.bin",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/firebase_edit_alarm.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/relays.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/pressure.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/firebase_relay_logs.html",
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/alarm",
      "methods": ["GET", "PUT"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/relays",
      "methods": ["GET"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/relay-logs",
      "methods": ["GET", "DELETE"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/command",
      "methods": ["PUT"],
      "allowedRoles": ["kurudere_admin"]
    },
    {
      "route": "/api/pressure",
      "methods": ["GET", "PUT"],
      "allowedRoles": ["kurudere_admin"]
    }
  ],
  "mimeTypes": {
    ".bin": "application/octet-stream"
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  }
}